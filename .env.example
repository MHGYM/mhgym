# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── Database ──────────────────────────────────────────────────────────────
# Development: ./mhgym.db
# Production (Railway persistent volume): /data/mhgym.db
DB_PATH=./mhgym.db

# ─── Frontend URL (for CORS) ───────────────────────────────────────────────
# Development: http://localhost:5173
# Production:  https://your-app.up.railway.app  (same origin as API, can be omitted)
FRONTEND_URL=http://localhost:5173

# ─── Mollie Payments ───────────────────────────────────────────────────────
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Railway production URL for webhook + redirects
APP_BASE_URL=https://your-app.up.railway.app
MOLLIE_WEBHOOK_URL=https://your-app.up.railway.app/api/payments/webhook

# ─── Email (Nodemailer) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@mhgym.nl

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────
# Generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:info@mhgym.nl
