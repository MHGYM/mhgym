# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── Database ──────────────────────────────────────────────────────────────
# Development: ./mhgym.db
# Production (Railway persistent volume): /data/mhgym.db
DB_PATH=./mhgym.db

# ─── Frontend URL (for CORS) ───────────────────────────────────────────────
# Development: http://localhost:5173
# Production:  https://your-app.up.railway.app  (same origin as API, can be omitted)
FRONTEND_URL=http://localhost:5173

# ─── Mollie Payments ───────────────────────────────────────────────────────
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Railway production URL for webhook + redirects
APP_BASE_URL=https://your-app.up.railway.app
MOLLIE_WEBHOOK_URL=https://your-app.up.railway.app/api/payments/webhook

# ─── Email (Nodemailer) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@mhgym.nl

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────
# Keys below were generated with: npx web-push generate-vapid-keys
# Replace with your own generated keys for production (keep the private key secret).
VAPID_PUBLIC_KEY=BN6vlYmKU1_9nFNiNQghAd5n3yqfc6Hiyj8AhTSuNC8qGSwe7UP_4H6U77TxlNg1U36dD2e-DX1QSEsUdM-jdak
VAPID_PRIVATE_KEY=O95RKeuYB_Lr9fHHSEWqaOq18FXf7UKsAHhpFYvuHMQ
VAPID_SUBJECT=mailto:info@mhgym.nl
